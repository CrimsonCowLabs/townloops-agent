[Unit]
Description=TownLoops town operations Hermes agent
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
# Edit these two lines for your deployment.
WorkingDirectory=/home/CLIENT/townloops-agent
EnvironmentFile=/home/CLIENT/townloops-agent/.env

# HERMES_HOME must point at the repo root — this is where skills/, config.yaml,
# SOUL.md, and the state/ subdir all live. `engine/db.py`, `engine/lock.py`,
# and every skill derive storage paths relative to this. The previous value
# (repo_root + "/state") made engine/db.py fall through to its docker default
# and split state across two directories on bare-systemd deploys.
Environment=HERMES_HOME=/home/CLIENT/townloops-agent
Environment=PYTHONPATH=/home/CLIENT/townloops-agent
ExecStart=/usr/bin/env python -m hermes_cli.main gateway run --replace
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target

# TownLoops Ingest API
TOWNLOOPS_API_URL=http://localhost:8004
TOWNLOOPS_API_KEY=tnl_replace_me
TOWNLOOPS_TOWN_SLUG=replace-me

# Listmonk (self-hosted newsletter)
LISTMONK_URL=http://localhost:9090
LISTMONK_USER=api_user
LISTMONK_TOKEN=replace_me
LISTMONK_LIST_ID=1

# Web tier (Firecrawl)
FIRECRAWL_API_KEY=fc-replace_me

# Telegram (agent chat)
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_CHAT_ID=replace_me

# LLM
ANTHROPIC_API_KEY=sk-ant-replace_me

# Feature flags
SPONSORS_ENABLED=false

# Paths (defaults are fine)
SOURCES_YAML_PATH=/home/agent/.hermes/state/sources.yaml
TOWNLOOPS_DB_PATH=/home/agent/.hermes/state/townloops.db
DISCOVERY_DB_PATH=/home/agent/.hermes/state/discovery.db

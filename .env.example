# Bundled (single-town) deploy env. For the hardened per-town topology,
# templates/env.example is canonical — it carries the extra dashboard / Codex /
# API-server vars that layout needs.

# TownLoops Ingest API
TOWNLOOPS_API_URL=http://localhost:8004
TOWNLOOPS_API_KEY=tnl_replace_me
TOWNLOOPS_TOWN_SLUG=replace-me

# Listmonk (self-hosted newsletter)
LISTMONK_URL=http://localhost:9090
LISTMONK_USER=api_user
LISTMONK_TOKEN=replace_me
LISTMONK_LIST_ID=1

# Web tier (Firecrawl) — local instance only; cloud Firecrawl is never used.
# Docker: the compose file defaults this to the bundled firecrawl-api.
# Native Hermes profile: set TOWNLOOPS_FIRECRAWL_URL instead (see README).
# FIRECRAWL_API_URL=http://localhost:8302
# FIRECRAWL_API_KEY=   # only if your local instance checks keys

# Telegram (agent chat)
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_CHAT_ID=replace_me

# LLM — the agent uses ChatGPT via the OpenAI Codex CLI (session auth from a
# host `codex login`, mounted at ~/.codex), NOT an API key. The Hermes model is
# set in config.yaml (provider: openai-codex). No LLM key belongs here.

# Operator dashboard (bcrypt hash from `bin/dashboard-hash-password`; escape $ as $$)
DASHBOARD_PASSWORD=
# Set true when fronting the dashboard with TLS (Caddy/nginx).
DASHBOARD_COOKIE_SECURE=false

# Hermes api_server (dashboard chat panel → /v1/chat/completions). Off by default
# in the bundled deploy; the per-town template enables it.
# API_SERVER_ENABLED=1
# API_SERVER_KEY=replace_me

# Feature flags
SPONSORS_ENABLED=false

# Paths — leave unset in most deploys.
# All defaults derive from $HERMES_HOME (docker sets it to /home/agent/.hermes;
# bare-systemd template sets it to the repo root). Only override these if you
# want state stored somewhere other than $HERMES_HOME/state/.
# SOURCES_YAML_PATH=/custom/state/sources.yaml
# TOWNLOOPS_DB_PATH=/custom/state/townloops.db
# DISCOVERY_DB_PATH=/custom/state/discovery.db

# Optional: log tuning. Level = DEBUG|INFO|WARNING|ERROR (default INFO).
# When set, TOWNLOOPS_LOG_FILE is written IN ADDITION to stdout.
# TOWNLOOPS_LOG_LEVEL=INFO
# TOWNLOOPS_LOG_FILE=/var/log/townloops-agent.log

# Optional: point at the CMO's townloops-research drafts.db for cross-checking
# unshipped business drafts. See docs/business-discovery-handoff.md.
# TOWNLOOPS_RESEARCH_DRAFTS_DB=/opt/townloops-research-drafts/drafts.db

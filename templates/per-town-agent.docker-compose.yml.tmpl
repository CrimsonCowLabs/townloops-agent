# Per-town townloops-agent — HARDENED for autonomous / YOLO mode.
# =============================================================
# Rendered per-town by `bin/townloops-agent-add {slug}` into
# ~/townloops-agents/{slug}/docker-compose.yml.
#
# Prerequisites (both from templates/_shared/):
#   - firecrawl stack up (creates external network `firecrawl-shared-net`)
#   - egress   stack up (creates external network `egress-net` with squid)
#
# Differences vs the repo root docker-compose.yml (single-town bundled):
#   - no `network_mode: host` — attaches to two well-known external nets
#   - no /var/run/docker.sock mount
#   - non-root user, read-only rootfs, tmpfs /tmp, cap_drop ALL
#   - HTTP egress routed through Squid allowlist (env HTTP_PROXY/HTTPS_PROXY)
#   - Listmonk reached via host.docker.internal (no host networking needed)
#   - HERMES_YOLO_MODE=1 so cron ticks can act without approval prompts

services:
  agent:
    build:
      context: /home/aaron/workspace/townloops-agent
      dockerfile: Dockerfile
    image: townloops-agent:local
    container_name: townloops-agent-{{SLUG}}
    hostname: townloops-agent-{{SLUG}}
    restart: unless-stopped
    env_file:
      - .env
    working_dir: /app

    user: "1000:1000"
    read_only: true
    tmpfs:
      - /tmp:noexec,nosuid,size=256m
      - /home/agent/.cache:size=64m
      # Hermes runtime creates sessions/logs/hooks/memories/skins/plans/
      # workspace/home under $HERMES_HOME on boot; rootfs is read-only, so
      # give it a writable tmpfs at the parent. The bind mounts below
      # (config, SOUL, skills, cron, state, town-profile, .codex) layer on
      # top of this tmpfs.
      - /home/agent/.hermes:size=256m,uid=1000,gid=1000
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true

    environment:
      HERMES_HOME: /home/agent/.hermes
      # uid 1000 isn't in /etc/passwd in this image, so expanduser("~")
      # falls back to "/" — which the telegram adapter tries to write
      # under (~/.local/state/...). Point HOME at the /tmp tmpfs instead.
      HOME: /tmp
      # HOME override breaks Codex CLI's default auth path; point it
      # explicitly at the mounted ChatGPT session.
      CODEX_HOME: /home/agent/.codex
      PYTHONPATH: /app
      # Hermes' entrypoint drops privileges and PATH-prefers /opt/hermes/.venv/,
      # whose Python doesn't have our pip deps. `uv pip install --system` puts
      # everything in /usr/local/lib/python3.13/. Force system Python for skill
      # subprocesses (engine.orchestrator._skill_run reads $PYTHON).
      PYTHON: /usr/bin/python3
      # Autonomous / dangerous mode — cron ticks must not sit at prompts.
      HERMES_YOLO_MODE: "1"
      # Hermes api_server platform — OpenAI-compatible /v1/chat/completions
      # etc. Consumed by the sibling dashboard container's chat panel.
      # Container-internal only (not host-mapped); auth is bearer key.
      API_SERVER_ENABLED: "1"
      API_SERVER_HOST: 0.0.0.0
      API_SERVER_PORT: "8642"
      API_SERVER_KEY: ${API_SERVER_KEY}
      # Per-town identity — stamps _worker_tag() output and orchestrator logs.
      # Overridable via .env if you're running two boxes for the same town.
      TOWNLOOPS_AGENT_HOSTNAME: townloops-agent-{{SLUG}}
      # In-network Firecrawl reachable by shared-stack DNS; bypasses proxy.
      FIRECRAWL_API_URL: ${FIRECRAWL_API_URL:-http://firecrawl-api:3002}
      # Listmonk on the host (self-hosted) — reachable via host.docker.internal.
      LISTMONK_URL: ${LISTMONK_URL:-http://host.docker.internal:9090}
      # All *other* HTTP egress goes via Squid allowlist.
      HTTP_PROXY:  http://squid.egress-net:3128
      HTTPS_PROXY: http://squid.egress-net:3128
      NO_PROXY:    firecrawl-api,firecrawl-api-1,localhost,127.0.0.1,host.docker.internal
      # Profile loader defaults to $HERMES_HOME/../town-profile.yaml. We
      # mount the profile under .hermes/ for container-file locality, so
      # point the loader at where it actually lives.
      TOWN_PROFILE_PATH: /home/agent/.hermes/town-profile.yaml

    depends_on: []

    networks:
      - firecrawl-shared-net
      - egress-net

    extra_hosts:
      - "host.docker.internal:host-gateway"

    volumes:
      # Repo mounted read-only by absolute path. `git pull` on the repo
      # updates every per-town stack on next `docker compose up -d`.
      - /home/aaron/workspace/townloops-agent/skills/business:/home/agent/.hermes/skills/business:ro
      - /home/aaron/workspace/townloops-agent/config.yaml:/home/agent/.hermes/config.yaml:ro
      - /home/aaron/workspace/townloops-agent/SOUL.md:/home/agent/.hermes/SOUL.md:ro
      - /home/aaron/workspace/townloops-agent/engine:/app/engine:ro
      # Hermes cron no_agent jobs use `script:` (path under $HERMES_HOME/scripts/)
      # — repo-owned wrappers that call the actual skill CLIs.
      - /home/aaron/workspace/townloops-agent/scripts:/home/agent/.hermes/scripts:ro
      # Per-town cron file lives in this per-town dir so a follower can
      # bind an empty jobs.json without changing the shared repo. RW —
      # Hermes needs to create cron/output/ and write next_run/last_run
      # state back into jobs.json when the scheduler advances.
      - ./cron:/home/agent/.hermes/cron:rw
      # State is writable — SQLite DB, categories snapshot, locks, drafts.
      - ./state:/home/agent/.hermes/state
      # Per-town profile — read by discovery skills for seed URLs + terms.
      - ./town-profile.yaml:/home/agent/.hermes/town-profile.yaml:ro
      # OpenAI Codex CLI session auth. RW so the CLI can refresh tokens
      # in-container. Same trust boundary as the TownLoops bearer in .env
      # — do not mount for containers you wouldn't trust with either.
      - /home/aaron/.codex:/home/agent/.codex:rw
      # Hermes' OWN auth store (separate from Codex CLI's ~/.codex/auth.json)
      # — required when model.provider=openai-codex in config.yaml so the
      # api_server chat platform can invoke ChatGPT-backed Codex.
      # Mounted RW because Hermes tries to atomically rewrite this file
      # when the ChatGPT access token refreshes (weekly cadence).
      #
      # KNOWN LIMITATION: single-file bind mounts do not support the
      # rename(tmp, target) that Hermes uses to swap in a fresh token
      # — Linux returns EBUSY regardless of RW permissions. Result: the
      # container's copy drifts stale over ~7 days and chat starts
      # returning "Codex auth is missing access_token".
      # Refresh procedure (until we move to a directory-mount+symlink
      # setup): on the host, run
      #     ~/workspace/hermes/.venv/bin/hermes auth add openai-codex \
      #       --type oauth --no-browser
      # to complete the OAuth device flow and rewrite ~/.hermes/auth.json,
      # then `docker compose restart agent` here to reload the file.
      - /home/aaron/.hermes/auth.json:/home/agent/.hermes/auth.json:rw

    command: python -m hermes_cli.main gateway run --replace

    deploy:
      resources:
        limits:
          cpus: "2.0"
          memory: 4G

  # ---------------------------------------------------------------------
  # Operator dashboard — same image, own command. Read-only rootfs like
  # the agent; talks to the same state DB (WAL mode → concurrent-safe).
  # Bound to 127.0.0.1:8090 — VPS operators front with nginx/TLS.
  # ---------------------------------------------------------------------
  dashboard:
    image: townloops-agent:local
    container_name: townloops-agent-{{SLUG}}-dashboard
    restart: unless-stopped
    env_file:
      - .env
    working_dir: /app
    user: "1000:1000"
    read_only: true
    tmpfs:
      - /tmp:noexec,nosuid,size=64m
      - /home/agent/.cache:size=32m
      - /home/agent/.hermes:size=64m,uid=1000,gid=1000
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true

    ports:
      # Default: loopback only. To reach from LAN/Tailscale on a trusted
      # workstation, change to "0.0.0.0:8090:8090". For VPS deployments,
      # keep loopback and front with nginx/Caddy + TLS.
      - "127.0.0.1:8090:8090"

    environment:
      HERMES_HOME: /home/agent/.hermes
      PYTHONPATH: /app
      # Chat panel spawns skill subprocesses that invoke Codex CLI. Same
      # HOME / CODEX_HOME pattern as the agent container.
      HOME: /tmp
      CODEX_HOME: /home/agent/.codex
      PYTHON: /usr/bin/python3
      TOWNLOOPS_AGENT_HOSTNAME: townloops-agent-{{SLUG}}-dashboard
      HTTP_PROXY:  http://squid.egress-net:3128
      HTTPS_PROXY: http://squid.egress-net:3128
      # Chat worker reaches the sibling agent's api_server directly via
      # container DNS — bypasses squid for that hostname.
      NO_PROXY:    firecrawl-api,firecrawl-api-1,localhost,127.0.0.1,host.docker.internal,townloops-agent-{{SLUG}}
      # Hermes chat endpoint the dashboard's chat_worker POSTs to.
      HERMES_API_URL: http://townloops-agent-{{SLUG}}:8642
      HERMES_API_KEY: ${API_SERVER_KEY}
      DASHBOARD_COOKIE_SECURE: "${DASHBOARD_COOKIE_SECURE:-false}"
      SQUID_ACCESS_LOG_PATH: /squid-log/access.log
      TOWN_PROFILE_PATH: /home/agent/.hermes/town-profile.yaml
      LISTMONK_URL: ${LISTMONK_URL:-http://host.docker.internal:9090}

    networks:
      - firecrawl-shared-net
      - egress-net

    extra_hosts:
      - "host.docker.internal:host-gateway"

    volumes:
      - /home/aaron/workspace/townloops-agent/dashboard:/app/dashboard:ro
      - /home/aaron/workspace/townloops-agent/engine:/app/engine:ro
      - /home/aaron/workspace/townloops-agent/skills/business:/home/agent/.hermes/skills/business:ro
      # State is rw — dashboard flips discovery_candidates.status on approve/reject.
      - ./state:/home/agent/.hermes/state
      - ./town-profile.yaml:/home/agent/.hermes/town-profile.yaml:ro
      # Cron schedule + per-job output history, read-only.
      - ./cron:/home/agent/.hermes/cron:ro
      # Read-only view of squid access.log for the /blocked page.
      - squid-egress-log:/squid-log:ro

    # Bypass the base image entrypoint (which swaps to a venv that lacks
    # our pip-installed deps). Use system python3 directly — that's the
    # one `uv pip install --system` in the Dockerfile writes to.
    entrypoint: []
    command: /usr/bin/python3 -m uvicorn dashboard.main:app --host 0.0.0.0 --port 8090

    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: 512M

networks:
  firecrawl-shared-net:
    external: true
  egress-net:
    external: true

volumes:
  squid-egress-log:
    external: true
    name: squid-egress-log

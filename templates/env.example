# Per-town .env — fill in and place at ~/townloops-agents/{slug}/.env
# NEVER commit this file. `bin/townloops-agent-add {slug}` renders a
# skeleton; you fill in real bearer/keys/chat-ids before `docker compose up`.

# --- TownLoops API -----------------------------------------------------
TOWNLOOPS_API_URL=https://townloops.com
# Public site origin for links in the newsletter; defaults to TOWNLOOPS_API_URL's origin.
# TOWNLOOPS_SITE_URL=https://townloops.com
TOWNLOOPS_API_KEY=<slug-scoped bearer here>
TOWNLOOPS_TOWN_SLUG={{SLUG}}

# --- OpenAI Codex CLI (entity-research classify) -----------------------
# LLM classifier uses the Codex CLI via ChatGPT session auth. No API key
# here — auth is provisioned once on the host via `codex login`, and the
# per-town docker-compose bind-mounts ~/.codex into the container so
# session tokens can be refreshed inside.
# Model for the skill-side `codex exec` calls (event-find, event-seed-discovery).
# Consumed by the Codex CLI, not by repo code. The Hermes gateway / dashboard-chat
# model is set separately in config.yaml (provider: openai-codex).
OPENAI_MODEL=gpt-5-codex

# --- Firecrawl ---------------------------------------------------------
# Local Firecrawl only — cloud Firecrawl is never used (engine/firecrawl_env.py).
# Default (unset) uses the shared self-hosted stack at firecrawl-api:3002.
# FIRECRAWL_API_URL=
# FIRECRAWL_API_KEY=   # only if your local instance checks keys

# --- Listmonk (newsletter push) ----------------------------------------
LISTMONK_URL=http://host.docker.internal:9090
LISTMONK_USER=
LISTMONK_TOKEN=
LISTMONK_LIST_ID=1

# --- Telegram (informational + per-transition notification) ------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Timezone (falls back to America/Los_Angeles in engine/ingest_core.py)
AGENT_TZ=America/Los_Angeles

# --- Sponsors ----------------------------------------------------------
# Seed approval is not an env flag: in autonomous mode it is the autonomy
# policy's seed trial/trust decision, configured in town-profile.yaml.
# Sponsors ship stays off by default — a compromise of the discovery
# heuristics shouldn't be able to publish sponsor placements.
SPONSORS_ENABLED=false

# --- Operator dashboard ------------------------------------------------
# Bcrypt hash of the operator password. Bootstrap sequence:
#   1. docker compose build            (image must exist first)
#   2. ../../bin/dashboard-hash-password    (prompts for password on TTY,
#                                            prints hash to stdout)
#   3. Paste the printed $2b$... hash below.
#   4. docker compose up -d dashboard
# Leaving this blank makes every login fail (no anonymous mode).
DASHBOARD_PASSWORD=

# Set to `true` if fronting the dashboard with TLS (nginx/caddy + Let's
# Encrypt). Default `false` for loopback dev — browsers refuse Secure
# cookies over plain http:// so leaving this false is required locally.
DASHBOARD_COOKIE_SECURE=false

# --- Hermes chat panel (dashboard) -------------------------------------
# Bearer key the dashboard's chat panel presents to the sibling agent
# container's api_server platform (/v1/chat/completions).
# Generate once with: openssl rand -hex 32
# The agent + dashboard services both read this from .env. Both must
# be recreated (docker compose up -d) after rotating.
API_SERVER_KEY=

#!/usr/bin/env bash
# dashboard-hash-password — generate a bcrypt hash for DASHBOARD_PASSWORD.
#
# Reads the password from stdin (never argv, so it doesn't leak into
# `ps` output). Runs it through `python -m dashboard.auth hash` inside a
# throwaway container using the townloops-agent:local image — so the
# image must have been built first (`docker compose build`).
#
# Usage:
#   ./bin/dashboard-hash-password
#   → prompts for password on a TTY, prints bcrypt hash to stdout.
#
# Non-interactive:
#   printf 'mypassword' | ./bin/dashboard-hash-password
#
# Paste the printed hash into your per-town .env as:
#   DASHBOARD_PASSWORD=$2b$12$…

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

# If stdin is a TTY, prompt (with -s to hide input). Otherwise pipe stdin
# straight through.
if [[ -t 0 ]]; then
  read -rs -p "Dashboard password: " pw
  echo >&2
  if [[ -z "$pw" ]]; then
    echo "empty password rejected" >&2
    exit 2
  fi
  printf '%s' "$pw" | docker run --rm -i \
    --entrypoint /usr/bin/python3 \
    -v "$REPO_ROOT/dashboard:/app/dashboard:ro" \
    -w /app townloops-agent:local \
    -m dashboard.auth hash
else
  docker run --rm -i \
    --entrypoint /usr/bin/python3 \
    -v "$REPO_ROOT/dashboard:/app/dashboard:ro" \
    -w /app townloops-agent:local \
    -m dashboard.auth hash
fi

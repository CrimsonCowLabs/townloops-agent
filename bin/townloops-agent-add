#!/usr/bin/env bash
# townloops-agent-add — scaffold a per-town townloops-agent instance.
#
# Usage: bin/townloops-agent-add <slug> [--target-dir DIR] [--autonomous | --rerender]
#
# Creates ~/townloops-agents/{slug}/ (or --target-dir/{slug}) with:
#   docker-compose.yml    — hardened per-town compose (references the shared repo)
#   .env                  — from templates/env.example (with {{SLUG}} substituted)
#   town-profile.yaml     — from templates/town-profile.example.yaml
#   cron/jobs.json        — a copy of the repo's own cron/jobs.json (--rerender refreshes it)
#   cron/jobs.empty.json  — optional follower-mode override target
#   state/                — empty; agent creates state/townloops.db + others on first tick
#
# --autonomous: scaffold the town in autonomous mode — town-profile.yaml gets
# `operating_mode: autonomous` and docker-compose.override.yml puts the
# dashboard service behind a profile no one enables (an autonomous town's
# only review step is the TownLoops moderation queue; the dashboard also
# refuses to start in that mode).
#
# Idempotent: refuses to overwrite existing files. Missing shared stacks
# are reported as warnings — the docker compose up will fail with a clear
# error until they're brought up.
#
# --rerender: re-render an EXISTING town's docker-compose.yml from the current
# template, and refresh a leader town's cron/jobs.json from the repo's (a
# follower's emptied schedule or jobs.empty.json binding is left alone; the old
# jobs.json is kept as jobs.json.bak-<time>). Nothing else is touched. It refuses, leaving the compose as it
# was, unless the re-rendered stack can boot: hermes-home exists (created if
# missing) and is owned by the container user, Hermes' own ChatGPT login
# (hermes-home/auth.json) is there, and the host's Codex CLI login is there.
# The old compose is kept as docker-compose.yml.bak-<time> and the diff is
# printed — move any host-specific edits into docker-compose.override.yml.
# If the town's town-profile.yaml says `operating_mode: autonomous`, it also
# writes the dashboard-disabling docker-compose.override.yml when there is
# none, and refuses (nothing changed) when the operator's own override
# doesn't disable the dashboard — add the line it prints, then re-run.

set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
TEMPLATES="$REPO/templates"
BASE_DIR="${TOWNLOOPS_AGENTS_ROOT:-$HOME/townloops-agents}"

usage() {
  echo "usage: $0 <slug> [--target-dir DIR] [--autonomous | --rerender]" >&2
  echo "       $0 --egress [--target-dir DIR]   (writes DIR/_egress/squid.conf)" >&2
  echo "  <slug>              lowercase alphanumeric + hyphens (matches TownLoops)" >&2
  echo "  --target-dir DIR    override BASE_DIR (default: \$TOWNLOOPS_AGENTS_ROOT or \$HOME/townloops-agents)" >&2
  echo "  --autonomous        scaffold in autonomous mode (no local dashboard)" >&2
  echo "  --rerender          re-render an existing town's docker-compose.yml" >&2
  echo "  --egress            compile every town's allowed_hosts into the shared Squid allowlist" >&2
  exit 2
}

if [[ $# -lt 1 ]]; then
  usage
fi

SLUG=""
RERENDER=0
AUTONOMOUS=0
EGRESS=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --target-dir)
      BASE_DIR="$2"; shift 2 ;;
    --rerender)
      RERENDER=1; shift ;;
    --autonomous)
      AUTONOMOUS=1; shift ;;
    --egress)
      EGRESS=1; shift ;;
    -h|--help)
      usage ;;
    -*)
      echo "unknown option: $1" >&2; usage ;;
    *)
      if [[ -n "$SLUG" ]]; then
        echo "positional slug given twice ($SLUG, $1)" >&2; usage
      fi
      SLUG="$1"; shift ;;
  esac
done

if [[ "$EGRESS" == 1 ]]; then
  if [[ -n "$SLUG" || "$RERENDER" == 1 || "$AUTONOMOUS" == 1 ]]; then
    echo "--egress compiles every town under $BASE_DIR; it takes no slug, --rerender or --autonomous" >&2
    exit 2
  fi
  # engine/egress.py reads every town's profile and writes
  # $BASE_DIR/_egress/squid.conf — outside the repo, in place (same inode:
  # Squid's single-file bind mount keeps seeing it). Reloading the shared
  # Squid stays the operator's step.
  PYTHONPATH="$REPO" exec "${PYTHON:-python3}" -m engine.egress "$BASE_DIR"
fi

if [[ -z "$SLUG" ]]; then usage; fi
if [[ "$RERENDER" == 1 && "$AUTONOMOUS" == 1 ]]; then
  echo "--autonomous is for a new town; --rerender reads the mode from the town's town-profile.yaml (operating_mode)" >&2
  exit 2
fi
if [[ ! "$SLUG" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]]; then
  echo "slug must be lowercase alphanumeric + hyphens (no leading/trailing hyphen)" >&2
  exit 2
fi

TARGET="$BASE_DIR/$SLUG"
# The compose template runs the agent as this uid ("user:" line).
CONTAINER_UID="${TOWNLOOPS_CONTAINER_UID:-1000}"
# The invoking user's Codex CLI login, bind-mounted into both containers:
# an explicit CODEX_HOME (the Codex CLI's own override) wins over ~/.codex.
CODEX_DIR="${CODEX_HOME:-$HOME/.codex}"

# Both land in compose's short volume syntax (host:container:mode), where a
# ':' in the host path splits it wrong.
for host_path in "$REPO" "$CODEX_DIR"; do
  if [[ "$host_path" == *:* ]]; then
    echo "refusing: $host_path contains ':', which breaks docker compose's host:container volume syntax —" >&2
    echo "move/clone it to a path without ':' and run the scaffolder from there" >&2
    exit 2
  fi
done

sed_escape() {  # a literal for the right-hand side of s|...|...|
  printf '%s' "$1" | sed -e 's/[\\|&]/\\&/g'
}

# Templates name the town and every host path as {{SLUG}}, {{REPO}} (the repo
# this script runs out of) and {{CODEX_HOME}} (the invoking user's Codex login).
render() {
  local src="$1" dest="$2"
  if [[ ! -f "$src" ]]; then
    echo "missing template: $src" >&2; exit 4
  fi
  sed -e "s|{{SLUG}}|$SLUG|g" \
      -e "s|{{REPO}}|$(sed_escape "$REPO")|g" \
      -e "s|{{CODEX_HOME}}|$(sed_escape "$CODEX_DIR")|g" "$src" > "$dest"
}

# An autonomous town doesn't run the local dashboard: its override puts the
# service behind a compose profile no one enables.
DASHBOARD_PROFILE="supervised-dashboard"
DASHBOARD_OFF="services: {dashboard: {profiles: [\"$DASHBOARD_PROFILE\"]}}"

is_autonomous_town() {  # town-profile.yaml says operating_mode: autonomous
  grep -Eq "^operating_mode:[[:space:]]*[\"']?autonomous[\"']?[[:space:]]*(#.*)?$" \
    "$1/town-profile.yaml" 2>/dev/null
}

write_dashboard_override() {  # a new override file only — never overwrites
  cat > "$1/docker-compose.override.yml" <<EOF
# Written by bin/townloops-agent-add: this town runs in autonomous mode
# (town-profile.yaml operating_mode: autonomous), so the local dashboard
# doesn't run — the TownLoops admin moderation queue is its only review step.
# Add host-specific changes below; keep the dashboard profile while the town
# is autonomous (the dashboard refuses to start in that mode anyway).
$DASHBOARD_OFF
EOF
}

is_follower_town() {  # cron is switched off: the override binds jobs.empty.json, or jobs.json was emptied
  grep -q "jobs.empty.json" "$1/docker-compose.override.yml" 2>/dev/null \
    || grep -Eq '"jobs"[[:space:]]*:[[:space:]]*\[[[:space:]]*\]' "$1/cron/jobs.json" 2>/dev/null
}

refresh_cron() {  # a leader town's cron/jobs.json ← the repo's schedule
  local town="$1" jobs="$1/cron/jobs.json"
  if is_follower_town "$town"; then
    echo "$jobs left alone: follower town (cron switched off)"
    return
  fi
  if [[ ! -f "$REPO/cron/jobs.json" ]]; then
    echo "missing schedule: $REPO/cron/jobs.json" >&2; exit 4
  fi
  if cmp -s "$REPO/cron/jobs.json" "$jobs"; then
    echo "$jobs is up to date with the repo's schedule"
    return
  fi
  mkdir -p "$town/cron"
  if [[ -f "$jobs" ]]; then
    local backup
    backup="$jobs.bak-$(date +%Y%m%d-%H%M%S)"
    cp -p "$jobs" "$backup"
    echo "refreshed $jobs from $REPO/cron/jobs.json (previous: $backup)."
    echo "Hermes' run state in it (next/last run, pauses) starts over; apply with: cd $town && docker compose restart agent"
  else
    echo "wrote $jobs from $REPO/cron/jobs.json"
  fi
  cp "$REPO/cron/jobs.json" "$jobs"
}

if [[ "$RERENDER" == 1 ]]; then
  COMPOSE="$TARGET/docker-compose.yml"
  if [[ ! -f "$COMPOSE" ]]; then
    echo "no town at $TARGET (no docker-compose.yml) — scaffold it without --rerender" >&2
    exit 3
  fi
  # The template bind-mounts ./hermes-home as $HERMES_HOME. Missing, docker
  # would create it root-owned and the non-root agent couldn't write to it.
  if [[ ! -d "$TARGET/hermes-home" ]]; then
    mkdir -m 700 "$TARGET/hermes-home"
    echo "created $TARGET/hermes-home"
  fi
  owner="$(stat -c %u "$TARGET/hermes-home")"
  if [[ "$owner" != "$CONTAINER_UID" ]]; then
    echo "refusing to re-render: $TARGET/hermes-home is owned by uid $owner, the container runs as $CONTAINER_UID:" >&2
    echo "  sudo chown -R $CONTAINER_UID:$CONTAINER_UID $TARGET/hermes-home" >&2
    exit 5
  fi
  if [[ ! -f "$TARGET/hermes-home/auth.json" ]]; then
    echo "refusing to re-render: the town has no Hermes ChatGPT login ($TARGET/hermes-home/auth.json)." >&2
    echo "Log it in first (never copy ~/.hermes/auth.json — shared refresh tokens invalidate each other):" >&2
    echo "  HERMES_HOME=$TARGET/hermes-home ~/workspace/hermes/.venv/bin/hermes \\" >&2
    echo "    auth add openai-codex --type oauth --no-browser" >&2
    exit 6
  fi
  OVERRIDE="$TARGET/docker-compose.override.yml"
  WRITE_OVERRIDE=0
  if is_autonomous_town "$TARGET"; then
    if [[ ! -e "$OVERRIDE" ]]; then
      WRITE_OVERRIDE=1
    elif ! grep -q "$DASHBOARD_PROFILE" "$OVERRIDE"; then
      echo "refusing to re-render: $TARGET is autonomous but its docker-compose.override.yml" >&2
      echo "doesn't keep the dashboard from starting. Add this (merged into any existing" >&2
      echo "services: key) to $OVERRIDE, then re-run:" >&2
      echo "  $DASHBOARD_OFF" >&2
      exit 9
    fi
  fi
  new="$(mktemp "$TARGET/.docker-compose.yml.XXXXXX")"
  trap 'rm -f "$new"' EXIT
  render "$TEMPLATES/per-town-agent.docker-compose.yml.tmpl" "$new"
  if [[ ! -f "$CODEX_DIR/auth.json" ]]; then
    echo "refusing to re-render: no Codex CLI login at $CODEX_DIR/auth.json (mounted into both containers) — run \`codex login\` on the host" >&2
    exit 7
  fi
  if [[ "$WRITE_OVERRIDE" == 1 ]]; then
    write_dashboard_override "$TARGET"
    echo "wrote $OVERRIDE (autonomous town: dashboard disabled) — apply with: cd $TARGET && docker compose up -d --remove-orphans"
  fi
  refresh_cron "$TARGET"
  if cmp -s "$new" "$COMPOSE"; then
    echo "$COMPOSE is up to date with the template"
    exit 0
  fi
  if command -v docker >/dev/null 2>&1 \
      && ! docker compose -f "$new" --project-directory "$TARGET" config -q; then
    echo "refusing to re-render: the rendered compose doesn't validate (above); $COMPOSE unchanged" >&2
    exit 8
  fi
  backup="$COMPOSE.bak-$(date +%Y%m%d-%H%M%S)"
  cp -p "$COMPOSE" "$backup"
  chmod --reference="$COMPOSE" "$new"
  mv "$new" "$COMPOSE"
  echo "re-rendered $COMPOSE (previous: $backup). Changes:"
  diff -u "$backup" "$COMPOSE" || true
  echo
  echo "Move any host-specific edits shown as removed above into $TARGET/docker-compose.override.yml,"
  echo "then: cd $TARGET && docker compose up -d"
  exit 0
fi

if [[ -e "$TARGET" ]]; then
  echo "refusing to overwrite existing $TARGET (re-render its compose with --rerender)" >&2
  exit 3
fi

mkdir -p "$TARGET/state" "$TARGET/cron"
# Writable $HERMES_HOME bind mount (own ChatGPT login lives here). Pre-create
# it so docker doesn't create it root-owned.
mkdir -m 700 -p "$TARGET/hermes-home"

render "$TEMPLATES/per-town-agent.docker-compose.yml.tmpl" "$TARGET/docker-compose.yml"
render "$TEMPLATES/env.example"                            "$TARGET/.env.example"
render "$TEMPLATES/town-profile.example.yaml"              "$TARGET/town-profile.yaml"

if [[ "$AUTONOMOUS" == 1 ]]; then
  profile="$TARGET/town-profile.yaml"
  if grep -q '^# operating_mode: autonomous$' "$profile"; then
    sed -i 's/^# operating_mode: autonomous$/operating_mode: autonomous/' "$profile"
  else
    printf '\noperating_mode: autonomous\n' >> "$profile"
  fi
  write_dashboard_override "$TARGET"
fi

# Copy the .env template so operator can edit in-place; block-copy so the
# real .env isn't populated with placeholders that ship secrets.
cp "$TARGET/.env.example" "$TARGET/.env"

# Cron: a copy of the repo's own schedule (cron/jobs.json — the one source of
# truth; this folder keeps no schedule of its own). The town gets a copy, not a
# mount, because Hermes writes run state back into it; `--rerender` refreshes
# the copy from the repo (leader towns only). Per-town divergence goes in the
# town's docker-compose.override.yml. Follower mode: `mv cron/jobs.empty.json cron/jobs.json`.
if [[ ! -f "$REPO/cron/jobs.json" ]]; then
  echo "missing schedule: $REPO/cron/jobs.json" >&2; exit 4
fi
cp "$REPO/cron/jobs.json" "$TARGET/cron/jobs.json"

cat > "$TARGET/cron/jobs.empty.json" <<'EOF'
{ "version": 1, "jobs": [] }
EOF

# Sanity checks for shared stacks (advisory).
if ! docker network inspect firecrawl-shared-net >/dev/null 2>&1; then
  echo "warning: docker network firecrawl-shared-net not found — start the shared Firecrawl stack first:" >&2
  echo "  docker compose -f $TEMPLATES/_shared/firecrawl/docker-compose.yml up -d" >&2
fi
if ! docker network inspect egress-net >/dev/null 2>&1; then
  echo "warning: docker network egress-net not found — generate the allowlist and start the shared egress stack first:" >&2
  echo "  $REPO/bin/townloops-agent-add --egress" >&2
  echo "  docker compose -f $TEMPLATES/_shared/egress/docker-compose.yml up -d" >&2
fi

cat <<EOF
scaffolded: $TARGET

Next:
  1. Fill $TARGET/.env with real credentials (TownLoops bearer, Telegram, Listmonk).
     The LLM is the host's Codex CLI login ($CODEX_DIR — run \`codex login\` once).
  2. Edit $TARGET/town-profile.yaml — the town's name, region, allowed_hosts,
     and per-kind query seeds. Match categories to the town's live snapshot.
     Then compile every town's allowed_hosts into the shared Squid allowlist:
       $REPO/bin/townloops-agent-add --egress
  3. Give the town its own ChatGPT login for Hermes (device flow; never copy
     ~/.hermes/auth.json — shared refresh tokens invalidate each other):
       HERMES_HOME=$TARGET/hermes-home ~/workspace/hermes/.venv/bin/hermes \\
         auth add openai-codex --type oauth --no-browser
  4. Bring up:
       cd $TARGET
       docker compose up -d
  5. Watch the loop:
       docker compose logs -f agent
     (cron/jobs.json is the repo's schedule: event-find twice a day, the
      workqueue heartbeat every 10 min drives detail-read → derive → enrich → ship.)

Follower mode: mv cron/jobs.empty.json cron/jobs.json && docker compose restart agent
EOF
if [[ "$AUTONOMOUS" == 1 ]]; then
  cat <<EOF

Autonomous mode: town-profile.yaml has operating_mode: autonomous and
docker-compose.override.yml keeps the dashboard from starting — the TownLoops
admin moderation queue is the only review step. Give the town an api_ingest
key WITHOUT publish permission (TOWNLOOPS_API_KEY in .env).
EOF
fi
